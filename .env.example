APP_ENV=local
APP_NAME=data-cleaner
APP_API_PREFIX=/api/v1.0/data-cleaner
LOGGER_LEVEL=INFO
LOG_FILE_HANDLER_ENABLED=false
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_TOTAL_SIZE_CAP=52428800
LOG_PATH=./logs/data-cleaner.log
DB_NAME=data_cleaner
DB_USER=data_cleaner
DB_PASS=data_cleaner
POSTGRES_HOSTS=localhost:5432
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
ENCRYPT_CLIENT_FIO=true
ENCRYPTION_KEY=replace-with-shared-fernet-key
SUBSCRIBERS_CONFIG_PATH=app/utils/subscribers.yaml
AI_Q_SCORE_CALLBACK_ENABLED=true
AI_Q_SCORE_CALLBACK_URL=http://localhost:8082/api/v1.0/ai-q-score/internal/v1/dialogs/cleaned
CALL_SUMMARIZATION_CALLBACK_ENABLED=false
CALL_SUMMARIZATION_CALLBACK_URL=http://localhost:8090/internal/v1/dialogs/cleaned
AI_MENTOR_INSIGHT_CALLBACK_ENABLED=false
CALLBACK_TIMEOUT_SECONDS=15
CALLBACK_MAX_ATTEMPTS=5
CALLBACK_RETRY_SECONDS=60
WORKER_POLL_SECONDS=10
WORKER_STALE_SECONDS=1800
DATA_TTL_DAYS=183
