POSTGRES_DB=quality
POSTGRES_USER=quality
POSTGRES_PASSWORD=quality
POSTGRES_HOST_PORT=55432
DB_NAME=quality
DB_USER=quality
DB_PASS=quality
# Comma-separated host:port entries. asyncpg selects a writable primary.
POSTGRES_HOSTS=postgres:5432,postgres-replica:5432
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_RECYCLE_SECONDS=3600

LOG_LEVEL=INFO
LOG_LLM_RESPONSES=true

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=salute-speech
KAFKA_GROUP_ID=quality-kafka-consumer
KAFKA_MAX_MESSAGE_SIZE=10485760

CLEANER_BASE_URL=http://data-cleaner:8080
CLEANER_TIMEOUT_SECONDS=10
CLEANER_CALLBACK_URLS=["http://analyzer:8080/internal/v1/dialogs/cleaned"]
CLEANER_POLL_INTERVAL_SECONDS=30
CLEANER_WORKER_BATCH_SIZE=10
CLEANER_CALLBACK_CONCURRENCY=10
CLEANER_CALLBACK_QUEUE_SIZE=1000
CLEANER_CALLBACK_TIMEOUT_SECONDS=10

CHUNK_STORAGE_ENCRYPTED=false
CLEANER_REQUEST_ENCRYPTED=false
# Base64url-encoded 16/24/32-byte AES key. In production inject it from Vault/Secret.
CRYPTO_KEY=

UCP_BASE_URL=http://ucp:8080
UCP_TIMEOUT_SECONDS=10

# В Docker Compose по умолчанию используется бесплатная локальная Ollama.
# Значение gigachat сохраняет production-провайдер без изменения его логики.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CHARS_PER_TOKEN=2.0
# Пустое значение включает весь каталог. Compose по умолчанию ограничивает E2E
# тремя простыми критериями, чтобы маленькая локальная модель отвечала стабильнее.
ACTIVE_CRITERIA_CODES=GENERAL_01,GENERAL_02,GENERAL_03
CALENDAR_FILTER_ENABLED=false

GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_CORP
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CERT_FILE=
GIGACHAT_KEY_FILE=
GIGACHAT_TIMEOUT_SECONDS=120
GIGACHAT_MAX_CONCURRENCY=1
GIGACHAT_MAX_ATTEMPTS=5
GIGACHAT_RETRY_BASE_SECONDS=1
GIGACHAT_TEMPERATURE=0.1
# Альтернатива TEMPERATURE; одновременно задавать оба параметра нельзя.
# GIGACHAT_TOP_P=0.9
GIGACHAT_MAX_OUTPUT_TOKENS=8000
GIGACHAT_REPETITION_PENALTY=1.0
GIGACHAT_MAX_INPUT_TOKENS=116000
GIGACHAT_PROMPT_RESERVE_TOKENS=2000
GIGACHAT_OUTPUT_RESERVE_TOKENS=8000
AGGREGATION_MAX_BATCH_ITEMS=15

# Менеджер анализируется только при наличии в этом set.
ANALYZED_MANAGER_IDS=00000001,00000002
# Для каждого менеджера задаётся обязательная последовательная цепочка.
PROMPT_ANALYZER_MANAGER_IDS=00000001,00000002
AUDIO_ANALYZER_MANAGER_IDS=
FAQ_ANALYZER_MANAGER_IDS=
AUDIO_ANALYZER_URL=
FAQ_ANALYZER_URL=
EXTERNAL_ANALYZER_TIMEOUT_SECONDS=300
WORKER_POLL_INTERVAL_SECONDS=30
WORKER_CLAIM_LIMIT=100
DIALOG_PIPELINE_CONCURRENCY=10
MIN_DIALOG_DURATION_SECONDS=50
DEPOSIT_ANALYSIS_ENABLED=true
CRITERIA_VERSION=prompt-4q-v1
PROMPT_VERSION=prompt-4q-v1
REPORT_VERSION=v1
DASHBOARD_ENABLED=true
DASHBOARD_CRON_HOUR_UTC=18
METRIC_ROLLING_WINDOW_DAYS=30
STRENGTH_MIN_PERCENT=80
STRENGTHS_LIMIT=3
IMPROVEMENTS_LIMIT=3
RISK_CLIENTS_LIMIT=4
LATEST_COMMUNICATIONS_LIMIT=5
METRIC_FAILED_COMMUNICATIONS_LIMIT=3
METRIC_WEEKLY_POINTS_LIMIT=4
CRITICAL_SCORE_CAP=80
EMPTY_SCORE_VALUE=0

