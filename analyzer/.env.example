# ============================== Приложение ==============================
APP_NAME=ai-q-score                              # Название сервиса
APP_API_PREFIX=/api/v1.0/ai-q-score             # Общий префикс REST API

# ================================ Логи =================================
LOGGER_DEBUG=false                               # Включает подробный режим логирования
LOGGER_LEVEL=INFO                                # Минимальный уровень логов
LOG_FILE_HANDLER_ENABLED=true                    # Записывать логи в файл
LOG_MAX_BYTES=10485760                           # Максимальный размер одного лог-файла
LOG_BACKUP_COUNT=5                               # Количество архивных лог-файлов
LOG_TOTAL_SIZE_CAP=52428800                      # Общий лимит размера логов
LOG_PATH=./logs/ai-q-score.log                   # Путь к лог-файлу
CONTEXT_VARS=["request_id","call_id","manager_id"] # Поля контекста каждого запроса
JSON_MDC_MAPPING={"rqUid":"request_id","communicationId":"call_id"} # Соответствие внешних и внутренних полей
LOG_LLM_RESPONSES=true                           # Печатать полный структурированный ответ GigaChat

# ======================== Monitoring и аудит ===========================
MANAGEMENT_PORT=8081                             # Порт технических метрик
PROMETHEUS_PATH=/actuator/prometheus             # Путь Prometheus
AUDIT_BOOTSTRAP_SERVERS=""                       # Kafka-серверы аудита
AUDIT_METAMODEL_TOPIC=audit-metamodel            # Топик метамодели аудита
AUDIT_EVENT_TOPIC=audit-hints                    # Топик событий аудита

# ============================== PostgreSQL ==============================
DB_NAME=ai_q_score                               # Имя базы данных
DB_USER=ai_q_score                               # Пользователь базы данных
DB_PASS=ai_q_score                               # Пароль тестовой базы данных
POSTGRES_HOSTS=localhost:5432                    # Хосты master через запятую вместе с портами
POSTGRES_POOL_SIZE=10                            # Постоянные соединения пула
POSTGRES_MAX_OVERFLOW=20                         # Дополнительные соединения при нагрузке
POSTGRES_POOL_RECYCLE_SECONDS=3600               # Переоткрытие старых соединений
DB_AUTO_CREATE_SCHEMA=true                       # Создать схему и таблицы при старте локальной среды

# =============================== GigaChat ===============================
GIGACHAT_BASE_URL=https://gigachat-ift.sberdevices.delta.sbrf.ru/v1 # Адрес GigaChat API
GIGACHAT_SCOPE=GIGACHAT_API_CORP                 # Корпоративный scope
GIGACHAT_MODEL=GigaChat-2-Max                    # Используемая модель
GIGACHAT_VERIFY_SSL=false                        # Проверять TLS-сертификат сервера
GIGACHAT_CERT_FILE=./app/certs/tls.crt1          # Клиентский сертификат
GIGACHAT_KEY_FILE=./app/certs/tls.key1           # Приватный ключ сертификата
GIGACHAT_TIMEOUT_SECONDS=120                     # Таймаут одного запроса
GIGACHAT_MAX_CONCURRENCY=1                       # Общий семафор запросов GigaChat
GIGACHAT_MAX_ATTEMPTS=5                          # Максимальное количество попыток
GIGACHAT_RETRY_BASE_SECONDS=1                    # Базовая задержка между попытками
GIGACHAT_VALIDATION_MAX_ATTEMPTS=3               # Повторы при неполном или некорректном наборе критериев
GIGACHAT_VALIDATION_RETRY_SECONDS=1              # Задержка между повторами невалидного ответа
GIGACHAT_TEMPERATURE=0.1                         # Стабильность ответа модели

# ======================== Роли и выбор менеджеров =======================
EFS_VIP_KM_MANAGER_IDS=00000001,00000002         # Менеджеры роли EFS_VIP_KM
EFS_VIP_AKM_MANAGER_IDS=""                       # Менеджеры роли EFS_VIP_AKM
EFS_VIP_DSB_MANAGER_IDS=""                       # Менеджеры роли EFS_VIP_DSB
EFS_VIP_TFS_MANAGER_IDS=""                       # Менеджеры роли EFS_VIP_TFS
ANALYZED_MANAGER_IDS=00000001,00000002           # Менеджеры, диалоги которых принимаются
PROMPT_ANALYZER_MANAGER_IDS=00000001,00000002    # Менеджеры для Prompt Analyzer
AUDIO_ANALYZER_MANAGER_IDS=""                    # Менеджеры будущего Audio Analyzer
FAQ_ANALYZER_MANAGER_IDS=""                      # Менеджеры будущего FAQ Analyzer
AUDIO_ANALYZER_URL=""                            # URL будущего Audio Analyzer
FAQ_ANALYZER_URL=""                              # URL будущего FAQ Analyzer
ACTIVE_CRITERIA_CODES=HYG_01,HYG_02,HYG_03,HYG_04,HYG_05,HYG_06,HYG_07,HYG_08,HYG_09,HYG_10,HYG_11,HYG_12,HYG_13,HYG_14,HYG_15,HYG_16,HYG_17,HYG_18,HYG_19,HYG_20,HYG_21,HYG_22,HYG_23,HYG_24,HYG_25,HYG_26,HYG_27 # Все Prompt 4Q критерии гигиены

# ========================== Анализ диалогов =============================
EXTERNAL_ANALYZER_TIMEOUT_SECONDS=300            # Таймаут будущих внешних анализаторов
WORKER_POLL_INTERVAL_SECONDS=10                  # Интервал чтения очереди worker-ом
WORKER_CLAIM_LIMIT=100                           # Сколько задач worker забирает за проход
WORKER_STALE_TASK_SECONDS=1800                   # Дольше худшего полного pipeline с ретраями
WORKER_RECOVERY_INTERVAL_SECONDS=60              # Интервал поиска зависших processing-задач
DIALOG_PIPELINE_CONCURRENCY=10                   # Параллельные pipeline анализа диалогов
MIN_DIALOG_DURATION_SECONDS=50                   # Минимальная длительность диалога
DEPOSIT_ANALYSIS_ENABLED=true                    # Включить анализ вкладов
CRITERIA_VERSION=prompt-4q-v1                    # Версия каталога критериев
PROMPT_VERSION=prompt-4q-v1                      # Версия промптов
DATA_TTL_DAYS=183                                # TTL данных примерно шесть месяцев
CALENDAR_FILTER_ENABLED=true                     # Применять cutoff 18:00 UTC и правила выходных
CRITICAL_SCORE_CAP=80                            # Максимальный score при критичном нарушении
DIALOG_IMPROVEMENTS_LIMIT=5                      # Максимум нарушений в отчёте одного диалога

# ========================= Построение dashboard =========================
DASHBOARD_ENABLED=true                           # Включить ежедневный scheduler
DASHBOARD_CRON_HOUR_UTC=18                       # Час построения витрины по UTC
DASHBOARD_ANALYSIS_GRACE_SECONDS=1800            # Максимальное ожидание processing после cutoff: 30 минут
DASHBOARD_MANAGER_BATCH_SIZE=50                  # Менеджеры в batch; ограничивает RAM ночного расчёта
DASHBOARD_CLEANUP_BATCH_SIZE=1000                # Строки в одном batch очистки
DATA_CLEANUP_INTERVAL_MINUTES=60                 # Независимая периодичность удаления данных с истёкшим TTL
EMPTY_SCORE_VALUE=0                              # Значение Q-score без коммуникаций

# ======================= Strengths и Improvements =======================
STRENGTHS_IMPROVEMENTS_PERIOD_DAYS=7             # Длина текущего и предыдущего периода Strengths/Improvements
METRIC_HISTORY_DAYS=30                           # Период промежуточной истории метрик
STRENGTH_MIN_PERCENT=80                          # Граница попадания в Strengths
STRENGTHS_MIN_SAMPLE_SIZE=10                     # Минимум коммуникаций только для Strengths
STRENGTHS_SAMPLE_WINDOW_DAYS=30                  # Период проверки минимальной выборки
STRENGTHS_EXCLUDED_METRIC_CODES=""               # Коды, запрещённые только в топе Strengths
UI_HIDDEN_METRIC_CODES="DEPOSIT_TOPIC"           # Технические метрики, которые считаются, но нигде не выводятся на UI
STRENGTHS_LIMIT=3                                # Количество карточек Strengths
DIALOG_STRENGTHS_LIMIT=5                         # Максимум сильных метрик в отчёте одного диалога
IMPROVEMENTS_LIMIT=3                             # Количество карточек Improvements
CERTAIN_IMPROVEMENT_COMMUNICATIONS_LIMIT=5       # Коммуникации в Certain Improvement Metric
CERTAIN_IMPROVEMENT_PERIODS_LIMIT=4              # Завершённые периоды в Certain Improvement Metric

# ================================ Риски =================================
RISK_ROLLING_WINDOW_DAYS=10                      # Календарное окно клиентских рисков

# ============================ Коммуникации ==============================
LATEST_COMMUNICATIONS_LIMIT=5                    # Коммуникации в snapshot dashboard
COMMUNICATIONS_MAX_LIMIT=100                     # Максимальный limit списка коммуникаций

# ============================ Тестовые данные ===========================
TEST_DATA_API_ENABLED=true                       # Включить ручку генерации тестовой истории
